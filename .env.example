# Login fixo do app
APP_EMAIL=voce@exemplo.com
APP_PASSWORD=troque-esta-senha
# Usuários extras (opcional): email:senha;email:senha
APP_USERS=
# Segredo para assinar o cookie de sessão (texto aleatório longo)
SESSION_SECRET=gere-um-texto-aleatorio-longo
# Upstash Redis (criado pela integração da Vercel). Sem eles, em dev o progresso fica em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Lembretes por notificação (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protege /api/remind; o mesmo valor vai no secret CRON_SECRET do GitHub
CRON_SECRET=
